   }
  },
  "spreadPct": 8,
  "maxRetries": 2,
  "rateMinPct": -10,
  "rateMaxPct": 25,
  "naturalWpm": {}
 },
 "request": {
  "intervalMs": 250,
  "concurrency": 2,
  "maxRetries": 5,
  "backoffBaseMs": 1500,
  "backoffMaxMs": 30000,
  "timeoutMs": 60000,
  "maxCharsPerRun": 400000
 },
