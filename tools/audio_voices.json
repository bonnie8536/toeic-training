   "聽力P4": {
    "min": 160,
    "max": 200,
    "mean": 181
   }
  },
  "spreadPct": 8,
  "maxRetries": 2,
  "rateMinPct": -10,
  "rateMaxPct": 25,
  "naturalWpm": {}
 },
