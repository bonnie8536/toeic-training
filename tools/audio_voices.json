  "intervalMs": 250,
  "concurrency": 2,
  "maxRetries": 5,
  "backoffBaseMs": 1500,
  "backoffMaxMs": 30000,
  "timeoutMs": 60000,
  "maxCharsPerRun": 400000
 },
 "output": {
  "format": "riff-24khz-16bit-mono-pcm",
  "sampleRate": 24000,
  "channels": 1,
  "mp3Kbps": 48
 },
